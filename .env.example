# Copy to .env, fill in, and NEVER commit with real values.
#
# HLMGR_* is the current prefix. LXCMGR_* aliases still work so an
# existing lxc-manager .env keeps booting after the upgrade.

HLMGR_SESSION_SECRET=
# Only used the first time it starts (empty users table). If
# HLMGR_ADMIN_PASSWORD is left blank, a random one is written to
# INITIAL_ADMIN_PASSWORD (mode 0600) next to the DB — never to the journal.
HLMGR_ADMIN_USER=admin
HLMGR_ADMIN_PASSWORD=

# Public URL of this panel (shown in Settings as the client install hint).
# HLMGR_PUBLIC_URL=https://homelab.example

HLMGR_DB_PATH=/home/lxcmgr/lxc-manager/homelab-manager.db

# Optional Telegram bootstrap. The UI Settings page can override these.
HLMGR_TELEGRAM_TOKEN=
HLMGR_TELEGRAM_CHAT_ID=

# --- optional: keep the original Proxmox LXC/VM module -----------------
# Leave blank to run as a pure client orchestrator (Ubuntu, Pi, Synology,
# Unraid, Proxmox hosts all phone home via homelab-client).
# HLMGR_PVE_API_URL=https://192.168.1.8:8006
# HLMGR_PVE_TOKEN_ID=lxc-manager@pve!api
# HLMGR_PVE_TOKEN_SECRET=
# Prefer the cluster CA (copy /etc/pve/pve-root-ca.pem into this LXC):
# HLMGR_PVE_CA_FILE=/home/lxcmgr/lxc-manager/pve-root-ca.pem
# HLMGR_PVE_VERIFY_SSL=1
# HLMGR_HOST_M700=192.168.1.8
# HLMGR_HOST_5060=192.168.1.6
# HLMGR_SSH_KEY=/home/lxcmgr/.ssh/id_ed25519
# HLMGR_PBS_STORAGE=unraid-pbs
# HLMGR_PBS_STORAGES=unraid-pbs,synology-pbs

# Self-update (git). Defaults: origin / main of this clone.
# HLMGR_UPDATE_REMOTE=origin
# HLMGR_UPDATE_BRANCH=main
