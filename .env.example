# Copy to .env, fill in, and NEVER commit with real values.
LXCMGR_PVE_API_URL=https://192.168.1.8:8006
LXCMGR_PVE_TOKEN_ID=lxc-manager@pve!api
LXCMGR_PVE_TOKEN_SECRET=
LXCMGR_PVE_VERIFY_SSL=0

LXCMGR_HOST_M700=192.168.1.8
LXCMGR_HOST_5060=192.168.1.6

LXCMGR_SSH_KEY=/home/lxcmgr/.ssh/id_ed25519
LXCMGR_DB_PATH=/home/lxcmgr/lxc-manager/lxc-manager.db

LXCMGR_TELEGRAM_TOKEN=
LXCMGR_TELEGRAM_CHAT_ID=

# The app's own login (independent of NPM's Basic Auth).
LXCMGR_SESSION_SECRET=
# Only used the first time it starts (empty users table). If
# LXCMGR_ADMIN_PASSWORD is left blank, a random one is generated and
# printed ONCE in the service log — change it afterwards from /settings.
LXCMGR_ADMIN_USER=admin
LXCMGR_ADMIN_PASSWORD=

# Pre-update safety snapshot destination (Update module only).
# "Back up now" writes to every discovered type=pbs storage.
# LXCMGR_PBS_STORAGE=unraid-pbs
# Optional pin of which PBS storages the Backups card tracks *and*
# "Back up now" writes to. Leave unset to auto-discover every type=pbs
# storage from the Proxmox API. Comma-separated to pin/order.
# LXCMGR_PBS_STORAGES=unraid-pbs,synology-pbs
